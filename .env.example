# Necode build configuration. `cp .env.example .env` and fill in what you need.
# Public identifiers only. Do not add secrets to this file.

# Apple team used to sign the macOS and iOS apps.
# T3CODE_APPLE_TEAM_ID=ABC1234567

# Optional: own Expo/EAS project for OTA updates. Leave unset to ship without OTA.
# EAS_PROJECT_ID=
# EXPO_OWNER=

# Necode does not use T3 Connect. Leave the relay and Clerk values unset so builds
# never talk to T3's cloud.
# T3CODE_RELAY_URL=
# T3CODE_CLERK_PUBLISHABLE_KEY=
